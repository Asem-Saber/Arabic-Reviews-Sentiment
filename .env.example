POSTGRES_PASSWORD=your_secure_password_here

# Logging Configuration
LOG_FILE=logs/app.log

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
FRONTEND_BACKEND_URL=http://localhost:8000
