# Application Configuration
APP_NAME=Arabic Review Sentiment API
APP_VERSION=1.0.0

# Model Configuration
MODEL_PATH=model/cls_model
LABEL_MAP_PATH=model/label_map.json
DEVICE=-1
MAX_LENGTH=128

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arabic_sentiment
